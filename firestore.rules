rules_version = '2';

// Each signed-in user can only see and change their own data.
//   users/{uid}               profile (name, email, photo, timestamps)
//   users/{uid}/state/main    synced progress, notes and daily activity
//   users/{uid}/events/{id}   append-only activity log (opens, grades)
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /state/{doc} {
        allow read, write: if isOwner(uid);
      }

      match /events/{eventId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['type', 'slug', 'num', 'title', 'cat', 'grade', 'interval', 'at']);
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
